{
  "name": "sistema-musical",
  "private": true,
  "version": "1.1.12",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "preview:music-ai": "node scripts/start-music-ai-preview.mjs",
    "build": "vite build",
    "build:desktop": "vite build --mode electron",
    "build:android": "vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "desktop:dev": "concurrently -k --names VITE,ELECTRON --prefix-colors blue,green \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "desktop:start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "desktop:build": "node scripts/patch-electron-builder-nsis.mjs && npm run build:desktop && electron-builder --win nsis --publish never",
    "test:rules": "node scripts/run-demo-firestore-test.mjs scripts/test-firestore-rules.mjs",
    "e2e:serve": "node scripts/run-e2e-vite.mjs",
    "seed:e2e": "node scripts/seed-e2e.cjs",
    "e2e:demo:emulators": "node scripts/run-demo-e2e-emulators.mjs",
    "test:e2e:fixtures": "node scripts/run-e2e-role-fixtures.mjs",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:visible": "node scripts/run-playwright-e2e.mjs --visible",
    "test:e2e:controller": "node scripts/run-playwright-e2e.mjs --controller",
    "test:e2e:controller:visible": "node scripts/run-playwright-e2e.mjs --controller --visible",
    "test:e2e:controller:mobile": "node scripts/run-playwright-e2e.mjs --controller --mobile",
    "test:e2e:controller:mobile:visible": "node scripts/run-playwright-e2e.mjs --controller --mobile --visible",
    "test:e2e:songs": "node scripts/run-playwright-e2e.mjs --songs",
    "test:e2e:songs:visible": "node scripts/run-playwright-e2e.mjs --songs --visible",
    "test:e2e:songs:mobile": "node scripts/run-playwright-e2e.mjs --songs --mobile",
    "test:e2e:songs:mobile:visible": "node scripts/run-playwright-e2e.mjs --songs --mobile --visible",
    "test:e2e:music": "node scripts/run-playwright-e2e.mjs --music",
    "test:e2e:music:visible": "node scripts/run-playwright-e2e.mjs --music --visible",
    "test:e2e:returns": "node scripts/run-playwright-e2e.mjs --returns",
    "test:e2e:returns:visible": "node scripts/run-playwright-e2e.mjs --returns --visible",
    "test:e2e:smoke": "node scripts/run-playwright-e2e.mjs --smoke",
    "test:latency": "node scripts/benchmark-realtime-latency.mjs",
    "test:projection-style": "node scripts/test-projection-style.mjs",
    "test:user-profile-bootstrap": "node scripts/run-demo-firestore-test.mjs scripts/test-user-profile-bootstrap.mjs",
    "test:prod:readonly": "playwright test --config=playwright.production-readonly.config.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "canvas-confetti": "^1.9.4",
    "electron-updater": "6.8.9",
    "firebase": "^12.13.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0",
    "xml2js": "^0.6.2"
  }
}
