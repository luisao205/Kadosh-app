rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentRole() {
      return hasUserDoc() ? get(userPath(request.auth.uid)).data.rol : null;
    }

    function hasAnyRole(roles) {
      return signedIn() && currentRole() in roles;
    }

    function permissionConfigPath() {
      return /databases/$(database)/documents/sistema/permissionRoles;
    }

    function normalizedRoleKey(role) {
      return role in ['dueño', 'dueno'] ? 'dueno' : role;
    }

    // Built-in fallbacks mirror the client defaults only when a permission has not been configured explicitly.
    function hasLegacyPermission(permission, role) {
      let roleKey = normalizedRoleKey(role);
      return roleKey == 'dueno'
        || (roleKey == 'admin' && permission in [
          'dashboard.view', 'events.view', 'events.create', 'events.edit', 'events.delete',
          'setlists.view', 'setlists.addSong', 'setlists.removeSong', 'setlists.reorder', 'setlists.control', 'setlists.manage',
          'songs.view', 'songs.create', 'songs.editLyrics', 'songs.editChords', 'songs.editMetadata', 'songs.manageMedia', 'songs.archive', 'songs.delete',
          'rehearsal.access', 'rehearsal.control', 'bible.view', 'bible.project', 'bible.quickProjection',
          'sermons.view', 'multimedia.libraryView', 'multimedia.upload', 'multimedia.edit', 'multimedia.delete', 'multimedia.centralAccess', 'multimedia.controlOutputs', 'multimedia.project',
          'canva.view', 'canva.create', 'canva.edit', 'canva.delete', 'canva.project', 'profile.editOwn'
        ])
        || (roleKey == 'multimedia' && permission in [
          'dashboard.view', 'events.view',
          'setlists.view', 'setlists.addSong', 'setlists.removeSong', 'setlists.reorder', 'setlists.control', 'setlists.manage',
          'songs.view', 'songs.create', 'songs.editLyrics', 'songs.editChords', 'songs.editMetadata', 'songs.manageMedia', 'songs.archive',
          'rehearsal.access', 'rehearsal.control', 'bible.view', 'bible.project', 'bible.quickProjection',
          'sermons.view', 'sermons.create', 'sermons.edit', 'sermons.createPoint', 'sermons.createBiblePassage', 'sermons.project',
          'multimedia.libraryView', 'multimedia.upload', 'multimedia.edit', 'multimedia.delete', 'multimedia.centralAccess', 'multimedia.controlOutputs', 'multimedia.project',
          'canva.view', 'canva.create', 'canva.edit', 'canva.delete', 'canva.project', 'profile.editOwn'
        ])
        || (roleKey == 'musico' && permission in ['dashboard.view', 'songs.view', 'rehearsal.access', 'bible.view', 'profile.editOwn', 'events.view', 'setlists.view'])
        || (roleKey == 'cantante' && permission in ['dashboard.view', 'songs.view', 'rehearsal.access', 'bible.view', 'profile.editOwn'])
        || (roleKey == 'pastor' && permission in [
          'dashboard.view', 'songs.view', 'rehearsal.access', 'bible.view', 'profile.editOwn', 'events.view', 'setlists.view', 'bible.project',
          'sermons.view', 'sermons.create', 'sermons.edit', 'sermons.createPoint', 'sermons.createBiblePassage', 'sermons.project'
        ])
        || (roleKey == 'predicador' && permission in ['dashboard.view', 'songs.view', 'rehearsal.access', 'bible.view', 'profile.editOwn', 'events.view', 'setlists.view', 'sermons.view']);
    }

    function hasPermissionOverride(profile, permission) {
      return 'permissionOverrides' in profile
        ? permission in profile.permissionOverrides
        : false;
    }

    function permissionOverrideIsEnabled(profile, permission) {
      return profile.permissionOverrides[permission] == true;
    }

    function hasConfiguredRolePermission(role, permission) {
      return exists(permissionConfigPath())
        ? hasConfiguredRolePermissionFromDocument(role, permission)
        : false;
    }

    function hasConfiguredRolePermissionFromDocument(role, permission) {
      let config = get(permissionConfigPath()).data;
      return 'roleDefaults' in config
        ? hasConfiguredRoleDefault(config.roleDefaults, role, permission)
        : false;
    }

    function hasConfiguredRoleDefault(defaults, role, permission) {
      let roleKey = normalizedRoleKey(role);
      return roleKey in defaults
        ? hasConfiguredPermissionValue(defaults[roleKey], permission)
        : false;
    }

    function hasConfiguredPermissionValue(permissions, permission) {
      return permission in permissions
        ? permissions[permission] == true
        : false;
    }

    function hasConfiguredRolePermissionEntry(role, permission) {
      return exists(permissionConfigPath())
        && hasConfiguredRolePermissionEntryFromDocument(role, permission);
    }

    function hasConfiguredRolePermissionEntryFromDocument(role, permission) {
      let config = get(permissionConfigPath()).data;
      let roleKey = normalizedRoleKey(role);
      return 'roleDefaults' in config
        && roleKey in config.roleDefaults
        && permission in config.roleDefaults[roleKey];
    }

    function hasPermission(permission) {
      let profile = get(userPath(request.auth.uid)).data;
      let role = profile.rol;
      return role in ['dueño', 'dueno']
        || (hasPermissionOverride(profile, permission)
          ? permissionOverrideIsEnabled(profile, permission)
          : (hasConfiguredRolePermissionEntry(role, permission)
            ? hasConfiguredRolePermission(role, permission)
            : hasLegacyPermission(permission, role)));
    }

    function sensitiveUserFields() {
      return ['rol', 'role', 'permissionOverrides', 'permissionAudit', 'ownership', 'owner', 'ownerUid', 'isOwner', 'sinAcceso'];
    }

    function operationalRoles() {
      return ['admin', 'multimedia', 'musico', 'cantante', 'pastor', 'predicador'];
    }

    function userCreateFields() {
      return [
        'nombre', 'email', 'rol', 'instrumentos', 'fechaNacimiento', 'accountStatus',
        'fechaCreacion', 'fechaActualizacion', 'telefono', 'photoURL', 'avatar',
        'preferencias', 'fcmToken', 'ultimaConexion', 'favoritos', 'avisosCumpleanos'
      ];
    }

    function ownerUserCreateFields() {
      return [
        'nombre', 'email', 'rol', 'instrumentos', 'fechaNacimiento', 'accountStatus',
        'fechaCreacion', 'fechaActualizacion', 'telefono', 'photoURL', 'avatar',
        'preferencias', 'fcmToken', 'ultimaConexion', 'favoritos', 'avisosCumpleanos', 'sinAcceso'
      ];
    }

    function isSafeUserCreate() {
      return request.resource.data.keys().hasOnly(userCreateFields())
        && request.resource.data.rol in operationalRoles();
    }

    function projectorStateIs(type, contentType) {
      return request.resource.data.projectorState is map
        && request.resource.data.projectorState.type == type
        && request.resource.data.projectorState.contentType == contentType;
    }

    function isExactBibleRestore() {
      return resource.data.projectorState is map
        && resource.data.projectorState.type == 'preaching'
        && resource.data.projectorState.contentType == 'bible'
        && resource.data.projectorState.previousProjectionFields is map
        && request.resource.data.projectorState == resource.data.projectorState.previousProjectionFields.projectorState
        && request.resource.data.proyectorSlide == resource.data.projectorState.previousProjectionFields.proyectorSlide
        && request.resource.data.proyectorMedia == resource.data.projectorState.previousProjectionFields.proyectorMedia
        && request.resource.data.proyectorLogo == resource.data.projectorState.previousProjectionFields.proyectorLogo
        && request.resource.data.proyectorApagado == resource.data.projectorState.previousProjectionFields.proyectorApagado
        && request.resource.data.proyectorFondo == resource.data.projectorState.previousProjectionFields.proyectorFondo
        && request.resource.data.proyectorFondoMedia == resource.data.projectorState.previousProjectionFields.proyectorFondoMedia
        && request.resource.data.proyectorSongId == resource.data.projectorState.previousProjectionFields.proyectorSongId
        && request.resource.data.proyectorSlideIndex == resource.data.projectorState.previousProjectionFields.proyectorSlideIndex
        && request.resource.data.proyectorNextSlide == resource.data.projectorState.previousProjectionFields.proyectorNextSlide
        && request.resource.data.proyectorNextSong == resource.data.projectorState.previousProjectionFields.proyectorNextSong
        && request.resource.data.proyectorOffset == resource.data.projectorState.previousProjectionFields.proyectorOffset
        && request.resource.data.liveState == resource.data.projectorState.previousProjectionFields.liveState
        && request.resource.data.currentSongId == resource.data.projectorState.previousProjectionFields.currentSongId;
    }

    function isExactBlackoutRestore() {
      return resource.data.projectorState is map
        && resource.data.projectorState.type == 'blackout'
        && resource.data.projectorState.previousProjectionFields is map
        && request.resource.data.projectorState == resource.data.projectorState.previousProjectionFields.projectorState
        && request.resource.data.proyectorSlide == resource.data.projectorState.previousProjectionFields.proyectorSlide
        && request.resource.data.proyectorMedia == resource.data.projectorState.previousProjectionFields.proyectorMedia
        && request.resource.data.proyectorLogo == resource.data.projectorState.previousProjectionFields.proyectorLogo
        && request.resource.data.proyectorApagado == resource.data.projectorState.previousProjectionFields.proyectorApagado
        && request.resource.data.proyectorFondo == resource.data.projectorState.previousProjectionFields.proyectorFondo
        && request.resource.data.proyectorFondoMedia == resource.data.projectorState.previousProjectionFields.proyectorFondoMedia
        && request.resource.data.proyectorSongId == resource.data.projectorState.previousProjectionFields.proyectorSongId
        && request.resource.data.proyectorSlideIndex == resource.data.projectorState.previousProjectionFields.proyectorSlideIndex
        && request.resource.data.proyectorNextSlide == resource.data.projectorState.previousProjectionFields.proyectorNextSlide
        && request.resource.data.proyectorNextSong == resource.data.projectorState.previousProjectionFields.proyectorNextSong
        && request.resource.data.proyectorOffset == resource.data.projectorState.previousProjectionFields.proyectorOffset
        && request.resource.data.liveState == resource.data.projectorState.previousProjectionFields.liveState
        && request.resource.data.currentSongId == resource.data.projectorState.previousProjectionFields.currentSongId
        && onlyEventKeys(bibleProjectionFields())
        && !changedEventKeys().hasAny(['announcementState']);
    }

    function blackoutPreviousProjectionIsTrusted() {
      let previous = request.resource.data.projectorState.previousProjectionFields;
      return previous is map
        && previous.projectorState == resource.data.projectorState
        && previous.proyectorSlide == resource.data.proyectorSlide
        && previous.proyectorMedia == resource.data.proyectorMedia
        && previous.proyectorLogo == resource.data.proyectorLogo
        && previous.proyectorApagado == resource.data.proyectorApagado
        && previous.proyectorFondo == resource.data.proyectorFondo
        && previous.proyectorFondoMedia == resource.data.proyectorFondoMedia
        && previous.proyectorSongId == resource.data.proyectorSongId
        && previous.proyectorSlideIndex == resource.data.proyectorSlideIndex
        && previous.proyectorNextSlide == resource.data.proyectorNextSlide
        && previous.proyectorNextSong == resource.data.proyectorNextSong
        && previous.proyectorOffset == resource.data.proyectorOffset
        && previous.liveState == resource.data.liveState
        && previous.currentSongId == resource.data.currentSongId;
    }

    function hasProjectionPermissionForRequestedState() {
      let state = request.resource.data.projectorState;
      return (resource.data.projectorState is map && resource.data.projectorState.contentType == 'bible'
          && isExactBibleRestore() && hasPermission('bible.project'))
        || (resource.data.projectorState is map && resource.data.projectorState.contentType == 'canva'
          && isExactCanvaRestore() && hasPermission('canva.project'))
        || (state is map && (
          (state.type == 'preaching' && state.contentType == 'bible' && hasPermission('bible.project'))
          || (state.type == 'preaching' && (!('contentType' in state) || state.contentType == 'preaching') && hasPermission('sermons.project'))
          || (state.type in ['media', 'lyrics'] && state.contentType in ['media', 'lyrics'] && hasPermission('multimedia.project'))
          || (state.type == 'canva' && state.contentType == 'canva' && hasPermission('canva.project'))
          || (state.type == 'announcement' && state.contentType == 'announcement' && hasPermission('announcements.project'))
          || (state.type in ['blackout', 'resume', 'logo', 'clearLogo', 'clearPreaching', 'timer'] && hasPermission('multimedia.controlOutputs'))
        ));
    }

    function bibleProjectionFields() {
      return ['projectorState', 'proyectorSlide', 'proyectorMedia', 'proyectorLogo', 'proyectorApagado',
        'proyectorFondo', 'proyectorFondoMedia', 'proyectorSongId', 'proyectorSlideIndex',
        'proyectorNextSlide', 'proyectorNextSong', 'proyectorOffset', 'liveState', 'currentSongId', 'canvaOutputs', 'mediaOutputs', 'announcementState', 'projectionTargets'];
    }

    function biblePreviousProjectionIsTrusted() {
      return request.resource.data.projectorState.previousProjectionFields is map
        && (
          (resource.data.projectorState is map && resource.data.projectorState.contentType == 'bible'
            && request.resource.data.projectorState.previousProjectionFields == resource.data.projectorState.previousProjectionFields)
          || (resource.data.projectorState is map && resource.data.projectorState.contentType != 'bible'
            && request.resource.data.projectorState.previousProjectionFields.projectorState == resource.data.projectorState
            && request.resource.data.projectorState.previousProjectionFields.proyectorMedia == resource.data.proyectorMedia
            && request.resource.data.projectorState.previousProjectionFields.proyectorSlide == resource.data.proyectorSlide
            && request.resource.data.projectorState.previousProjectionFields.proyectorLogo == resource.data.proyectorLogo
            && request.resource.data.projectorState.previousProjectionFields.proyectorApagado == resource.data.proyectorApagado
            && request.resource.data.projectorState.previousProjectionFields.proyectorFondo == resource.data.proyectorFondo
            && request.resource.data.projectorState.previousProjectionFields.proyectorFondoMedia == resource.data.proyectorFondoMedia
            && request.resource.data.projectorState.previousProjectionFields.proyectorSongId == resource.data.proyectorSongId
            && request.resource.data.projectorState.previousProjectionFields.proyectorSlideIndex == resource.data.proyectorSlideIndex
            && request.resource.data.projectorState.previousProjectionFields.proyectorNextSlide == resource.data.proyectorNextSlide
            && request.resource.data.projectorState.previousProjectionFields.proyectorNextSong == resource.data.proyectorNextSong
            && request.resource.data.projectorState.previousProjectionFields.proyectorOffset == resource.data.proyectorOffset
            && request.resource.data.projectorState.previousProjectionFields.liveState == resource.data.liveState
            && request.resource.data.projectorState.previousProjectionFields.currentSongId == resource.data.currentSongId)
        );
    }

    function validBibleProjectorState() {
      return projectorStateIs('preaching', 'bible')
        && request.resource.data.projectorState.keys().hasOnly([
          'type', 'contentType', 'preachingType', 'title', 'reference', 'translation', 'translationName',
          'content', 'provider', 'bibleId', 'passageId', 'copyright', 'bible', 'bibleSlideIndex',
          'bibleSlideCount', 'media', 'background', 'backgroundMedia', 'previousProjectorState',
          'previousProjectionFields', 'sourceActor', 'actorUid', 'actorName', 'actorRole', 'updatedBy',
          'updatedAt', 'projectionVersion', 'projectionActionId', 'timer', 'segments',
          'presentationType', 'alignment'
        ])
        && preservesLegacyBiblePresentationFields()
        && request.resource.data.projectorState.media == null
        && request.resource.data.projectorState.background == null
        && request.resource.data.projectorState.backgroundMedia == null
        && request.resource.data.proyectorMedia == null
        && request.resource.data.proyectorFondo == null
        && request.resource.data.proyectorFondoMedia == null
        && onlyEventKeys(bibleProjectionFields())
        && biblePreviousProjectionIsTrusted();
    }

    function preservesLegacyBiblePresentationFields() {
      let state = request.resource.data.projectorState;
      return (!('segments' in state)
          || (resource.data.projectorState is map
            && 'segments' in resource.data.projectorState
            && state.segments == resource.data.projectorState.segments))
        && (!('presentationType' in state)
          || (resource.data.projectorState is map
            && 'presentationType' in resource.data.projectorState
            && state.presentationType == resource.data.projectorState.presentationType))
        && (!('alignment' in state)
          || (resource.data.projectorState is map
            && 'alignment' in resource.data.projectorState
            && state.alignment == resource.data.projectorState.alignment));
    }

    function validSermonProjectorState() {
      return request.resource.data.projectorState is map
        && request.resource.data.projectorState.type == 'preaching'
        && (!('contentType' in request.resource.data.projectorState)
          || request.resource.data.projectorState.contentType == 'preaching')
        && !('bible' in request.resource.data.projectorState)
        && request.resource.data.proyectorMedia == null;
    }

    function canvaProjectionFields() {
      return ['projectorState', 'proyectorApagado', 'proyectorLogo'];
    }

    function canvaPreviousProjectorStateIsTrusted() {
      let state = request.resource.data.projectorState;
      let previous = state.previousProjectorState;
      return (resource.data.projectorState is map
          && resource.data.projectorState.type == 'canva'
          && resource.data.projectorState.contentType == 'canva'
          && previous == resource.data.projectorState.previousProjectorState)
        || (resource.data.projectorState is map
          && resource.data.projectorState.type != 'canva'
          && previous == resource.data.projectorState);
    }

    function validCanvaProjectorState() {
      let state = request.resource.data.projectorState;
      return projectorStateIs('canva', 'canva')
        && state.keys().hasOnly([
          'type', 'contentType', 'title', 'canva', 'previousProjectorState',
          'sourceActor', 'actorUid', 'actorName', 'updatedAt',
          'projectionVersion', 'projectionActionId'
        ])
        && state.title is string
        && state.canva is map
        && state.canva.keys().hasOnly(['sourceUrl', 'embedUrl'])
        && state.canva.sourceUrl is string
        && state.canva.embedUrl is string
        && state.sourceActor == 'multimedia'
        && state.actorName is string
        && state.updatedAt is int
        && state.projectionVersion is int
        && state.projectionActionId is string
        && request.resource.data.proyectorApagado == false
        && request.resource.data.proyectorLogo == false
        && onlyEventKeys(canvaProjectionFields())
        && canvaPreviousProjectorStateIsTrusted();
    }

    function isExactCanvaRestore() {
      return resource.data.projectorState is map
        && resource.data.projectorState.type == 'canva'
        && resource.data.projectorState.contentType == 'canva'
        && request.resource.data.projectorState == resource.data.projectorState.previousProjectorState
        && onlyEventKeys(['projectorState']);
    }

    function validMediaProjectorState() {
      return projectorStateIs('media', 'media')
        && request.resource.data.projectorState.media is map
        && request.resource.data.proyectorMedia is map;
    }

    function validLyricsProjectorState() {
      return projectorStateIs('lyrics', 'lyrics')
        && request.resource.data.projectorState.media == null
        && request.resource.data.proyectorMedia == null;
    }

    function hasValidProjectionStateForPermission() {
      let state = request.resource.data.projectorState;
      return (resource.data.projectorState is map && resource.data.projectorState.contentType == 'bible'
          && isExactBibleRestore() && onlyEventKeys(bibleProjectionFields()))
        || (resource.data.projectorState is map && resource.data.projectorState.contentType == 'canva'
          && isExactCanvaRestore())
        || (state is map && (
          (state.type == 'preaching' && state.contentType == 'bible' && validBibleProjectorState())
          || (state.type == 'preaching' && (!('contentType' in state) || state.contentType == 'preaching') && validSermonProjectorState())
          || (state.type == 'media' && state.contentType == 'media' && validMediaProjectorState())
          || (state.type == 'canva' && state.contentType == 'canva' && validCanvaProjectorState())
          || (state.type == 'lyrics' && state.contentType == 'lyrics' && validLyricsProjectorState())
          || (state.type == 'announcement' && state.contentType == 'announcement')
          || (state.type == 'blackout' && state.contentType == 'none' && blackoutPreviousProjectionIsTrusted())
          || state.type in ['resume', 'logo', 'clearLogo', 'clearPreaching', 'timer']
        ));
    }

    function isAdminLike() {
      return hasAnyRole(['dueño', 'dueno', 'admin']);
    }

    function isOwnerOnly() {
      return hasAnyRole(['dueño', 'dueno']);
    }

    function isMediaOrAdmin() {
      return hasAnyRole(['dueño', 'dueno', 'admin', 'multimedia']);
    }

    function isOwnerOrMedia() {
      return hasAnyRole(['dueño', 'dueno', 'multimedia']);
    }

    function isAdminReadOnly() {
      return hasAnyRole(['admin']);
    }

    function isPastorRole() {
      return hasAnyRole(['pastor']);
    }

    function isPastorLegacyRole() {
      return hasAnyRole(['predicador']);
    }

    function canUsePreacherPrivate() {
      return hasAnyRole(['dueño', 'dueno', 'admin', 'multimedia', 'predicador', 'pastor']);
    }

    function canReadPreachingShared() {
      return signedIn()
        && (
          hasPermission('sermons.view')
          || ((isPastorRole() || isPastorLegacyRole()) && resource.data.preacherId == request.auth.uid)
        );
    }

    function canCreatePreachingShared() {
      return signedIn()
        && (
          hasPermission('sermons.create')
          || (isPastorRole()
            && request.resource.data.preacherType == 'user'
            && request.resource.data.preacherId == request.auth.uid)
        );
    }

    function canUpdatePreachingShared() {
      return signedIn()
        && (
          hasPermission('sermons.edit')
          || (isPastorRole()
            && resource.data.preacherId == request.auth.uid
            && request.resource.data.preacherId == request.auth.uid
            && request.resource.data.preacherType == 'user')
        );
    }

    function preachingPath(predicaId) {
      return /databases/$(database)/documents/predicas/$(predicaId);
    }

    function mediaPath(mediaId) {
      return /databases/$(database)/documents/mediaLibrary/$(mediaId);
    }

    function isSharedActiveMediaData(data) {
      return (data.status == 'active' || !('status' in data))
        && (data.source == 'library' || !('source' in data));
    }

    function isSharedActiveMediaResource() {
      return isSharedActiveMediaData(resource.data);
    }

    function isSharedActiveMediaId(mediaId) {
      return mediaId is string
        && exists(mediaPath(mediaId))
        && isSharedActiveMediaData(get(mediaPath(mediaId)).data);
    }

    function canUsePreachingPrivate(predicaId) {
      return signedIn()
        && isPastorRole()
        && exists(preachingPath(predicaId))
        && get(preachingPath(predicaId)).data.preacherId == request.auth.uid
        && get(preachingPath(predicaId)).data.preacherType == 'user';
    }

    function eventPath(eventoId) {
      return /databases/$(database)/documents/eventos/$(eventoId);
    }

    function eventPreachingId(eventoId) {
      return exists(eventPath(eventoId)) ? get(eventPath(eventoId)).data.predicaId : null;
    }

    function isAssignedPastorForEventPreaching(eventoId) {
      return signedIn()
        && isPastorRole()
        && eventPreachingId(eventoId) != null
        && exists(preachingPath(eventPreachingId(eventoId)))
        && get(preachingPath(eventPreachingId(eventoId))).data.preacherId == request.auth.uid
        && get(preachingPath(eventPreachingId(eventoId))).data.preacherType == 'user';
    }

    function isValidPastorRequestCreate(eventoId) {
      return isAssignedPastorForEventPreaching(eventoId)
        && request.resource.data.predicaId == eventPreachingId(eventoId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['verse', 'point', 'quick_alert'];
    }

    function isPastorCancellingOwnRequest(eventoId) {
      return isAssignedPastorForEventPreaching(eventoId)
        && resource.data.requestedBy == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.predicaId == resource.data.predicaId
        && request.resource.data.status == 'cancelled';
    }

    function isOwnerOrMediaHandlingRequest() {
      return isOwnerOrMedia()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['projected', 'ignored'];
    }

    function changedEventKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyEventKeys(keys) {
      return changedEventKeys().hasOnly(keys);
    }

    function adminEventFields() {
      return [
        'titulo',
        'fecha',
        'fechaEnsayo',
        'tipoEvento',
        'lugar',
        'notas',
        'setlist',
        'canciones',
        'equipo',
        'estadoAsistencia',
        'cantantesPorCanción',
        'cantantesPorCancion',
        'corosPorCanción',
        'corosPorCancion',
        'responsables',
        'predicadorId',
        'predicadorNombre',
        'predicadorAsignado',
        'predicador',
        'predicaId',
        'predicaTitle',
        'ensayoChecklist',
        'estado',
        'completado',
        'canceladoAt',
        'canceladoPor',
        'fechaActualizacion',
        'fechaCreacion',
        'creadoPor'
      ];
    }

    function projectorEventFields() {
      return [
        'projectorState',
        'proyectorSlide',
        'proyectorMedia',
        'proyectorLogo',
        'proyectorApagado',
        'proyectorFondo',
        'proyectorFondoMedia',
        'proyectorTransicion',
        'proyectorModoTransmision',
        'proyectorCountdown',
        'proyectorSongId',
        'proyectorSlideIndex',
        'proyectorNextSlide',
        'proyectorNextSong',
        'proyectorOffset',
        'liveState',
        'currentSongId',
        'proyectorAlerta',
        'proyectorTicker',
        'outputs',
        'canvaOutputs',
        'mediaOutputs',
        'announcementState',
        'projectionTargets'
      ];
    }

    // Output controls must not depend on the content currently on a screen.
    function projectorControlFields() {
      return ['proyectorModoTransmision', 'proyectorTransicion', 'proyectorCountdown'];
    }

    function validProjectorCountdown() {
      return request.resource.data.proyectorCountdown is map
        && request.resource.data.proyectorCountdown.keys().hasOnly(['active', 'endTimestamp'])
        && request.resource.data.proyectorCountdown.active is bool
        && (
          (request.resource.data.proyectorCountdown.active
            && request.resource.data.proyectorCountdown.endTimestamp is int
            && request.resource.data.proyectorCountdown.endTimestamp >= 946684800000
            && request.resource.data.proyectorCountdown.endTimestamp <= 4102444800000)
          || (!request.resource.data.proyectorCountdown.active
            && request.resource.data.proyectorCountdown.endTimestamp == null)
        );
    }

    function canUpdateProjectorControls() {
      let changed = changedEventKeys();
      return hasPermission('multimedia.controlOutputs')
        && changed.hasOnly(projectorControlFields())
        && (!changed.hasAny(['proyectorModoTransmision'])
          || request.resource.data.proyectorModoTransmision is bool)
        && (!changed.hasAny(['proyectorTransicion'])
          || request.resource.data.proyectorTransicion in ['fade', 'slide', 'zoom', 'none'])
        && (!changed.hasAny(['proyectorCountdown']) || validProjectorCountdown());
    }

    function sharedEventParticipationFields() {
      return [
        'estadoAsistencia',
        'comentarios',
        'directorId',
        'currentSongId',
        'scrollY',
        'directorAutoScroll',
        'proyectorAlerta'
      ];
    }

    function pastorProjectionFields() {
      return [
        'projectorState',
        'proyectorSlide',
        'proyectorMedia',
        'proyectorLogo',
        'proyectorApagado',
        'proyectorFondoMedia',
        'proyectorSongId',
        'proyectorSlideIndex',
        'proyectorNextSlide',
        'proyectorNextSong',
        'liveState',
        'currentSongId'
      ];
    }

    function isPastorPreachingProjectorState(eventoId) {
      return isAssignedPastorForEventPreaching(eventoId)
        && request.resource.data.projectorState is map
        && request.resource.data.projectorState.type in ['preaching', 'clearPreaching']
        && request.resource.data.projectorState.sourceActor == 'pastor'
        && request.resource.data.projectorState.actorUid == request.auth.uid
        && request.resource.data.projectorState.predicaId == eventPreachingId(eventoId);
    }

    function isPastorPreachingMediaProjectorState(eventoId) {
      return isAssignedPastorForEventPreaching(eventoId)
        && request.resource.data.projectorState is map
        && request.resource.data.projectorState.type == 'media'
        && request.resource.data.projectorState.preachingType == 'mediaInstruction'
        && request.resource.data.projectorState.sourceActor == 'pastor'
        && request.resource.data.projectorState.actorUid == request.auth.uid
        && request.resource.data.projectorState.predicaId == eventPreachingId(eventoId)
        && request.resource.data.projectorState.blockId is string
        && request.resource.data.projectorState.blockId != ''
        && request.resource.data.projectorState.media is map
        && request.resource.data.projectorState.media.source == 'preaching'
        && request.resource.data.projectorState.media.predicaId == eventPreachingId(eventoId)
        && request.resource.data.projectorState.media.blockId == request.resource.data.projectorState.blockId
        && isSharedActiveMediaId(request.resource.data.projectorState.media.mediaId)
        && request.resource.data.proyectorMedia is map
        && request.resource.data.proyectorMedia.source == 'preaching'
        && request.resource.data.proyectorMedia.predicaId == eventPreachingId(eventoId)
        && request.resource.data.proyectorMedia.blockId == request.resource.data.projectorState.blockId
        && request.resource.data.proyectorMedia.mediaId == request.resource.data.projectorState.media.mediaId;
    }

    function isCurrentPastorPreachingProjectorState(eventoId) {
      return isAssignedPastorForEventPreaching(eventoId)
        && resource.data.projectorState is map
        && resource.data.projectorState.type == 'preaching'
        && resource.data.projectorState.sourceActor == 'pastor'
        && resource.data.projectorState.actorUid == request.auth.uid
        && resource.data.projectorState.predicaId == eventPreachingId(eventoId);
    }

    function canUpdateEventAsAdmin() {
      return hasPermission('events.edit') && onlyEventKeys(adminEventFields());
    }

    function validProjectionTargetsMap() {
      let targets = request.resource.data.projectionTargets;
      return targets is map
        && targets.keys().hasOnly(['projector', 'singers', 'musicians'])
        && targets.keys().hasAll(['projector', 'singers', 'musicians'])
        && targets.projector is bool
        && targets.singers is bool
        && targets.musicians is bool
        && (targets.projector == true || targets.singers == true || targets.musicians == true);
    }

    function canUpdateEventAsMedia() {
      return hasProjectionPermissionForRequestedState()
        && hasValidProjectionStateForPermission()
        && onlyEventKeys(projectorEventFields())
        && (!changedEventKeys().hasAny(['projectionTargets']) || validProjectionTargetsMap())
        && (
          !changedEventKeys().hasAny(['canvaOutputs'])
          || (request.resource.data.canvaOutputs is map && request.resource.data.canvaOutputs.keys().size() == 0)
          || (validCanvaOutputsMap() && canvaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['mediaOutputs'])
          || (request.resource.data.mediaOutputs is map && request.resource.data.mediaOutputs.keys().size() == 0)
          || (validMediaOutputsMap() && mediaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['announcementState'])
          || validInactiveAnnouncementState()
        );
    }


    function validMediaOutputState(state) {
      return state is map
        && state.keys().hasOnly([
          'active', 'mediaKey', 'mediaId', 'name', 'url', 'type', 'mode',
          'playing', 'volume', 'loop', 'seekRequest', 'updatedAt', 'updatedBy'
        ])
        && state.active == true
        && state.mediaKey is string
        && state.mediaKey != ''
        && state.mediaId is string
        && state.name is string
        && state.url is string
        && state.url != ''
        && state.type is string
        && state.mode == 'foreground'
        && state.playing is bool
        && (state.volume is int || state.volume is float)
        && state.volume >= 0
        && state.volume <= 1
        && state.loop is bool
        && (!('seekRequest' in state) || (
          state.seekRequest is map
          && state.seekRequest.keys().hasOnly(['type', 'time'])
          && state.seekRequest.type in ['start', 'back10', 'fwd10']
          && state.seekRequest.time is int
        ))
        && state.updatedAt is int
        && state.updatedBy is string;
    }

    function validMediaOutputsMap() {
      let outputs = request.resource.data.mediaOutputs;
      return outputs is map
        && outputs.keys().hasOnly(['projector', 'singers', 'musicians'])
        && (!('projector' in outputs) || validMediaOutputState(outputs.projector))
        && (!('singers' in outputs) || validMediaOutputState(outputs.singers))
        && (!('musicians' in outputs) || validMediaOutputState(outputs.musicians));
    }

    function mediaOutputsOnlyRemove() {
      let next = request.resource.data.mediaOutputs;
      let previous = ('mediaOutputs' in resource.data && resource.data.mediaOutputs is map)
        ? resource.data.mediaOutputs
        : {};
      return next is map
        && next.keys().hasOnly(['projector', 'singers', 'musicians'])
        && (!('projector' in next) || ('projector' in previous && next.projector == previous.projector))
        && (!('singers' in next) || ('singers' in previous && next.singers == previous.singers))
        && (!('musicians' in next) || ('musicians' in previous && next.musicians == previous.musicians));
    }

    function canvaOutputsOnlyRemove() {
      let next = request.resource.data.canvaOutputs;
      let previous = ('canvaOutputs' in resource.data && resource.data.canvaOutputs is map)
        ? resource.data.canvaOutputs
        : {};
      return next is map
        && next.keys().hasOnly(['projector', 'singers', 'musicians'])
        && (!('projector' in next) || ('projector' in previous && next.projector == previous.projector))
        && (!('singers' in next) || ('singers' in previous && next.singers == previous.singers))
        && (!('musicians' in next) || ('musicians' in previous && next.musicians == previous.musicians));
    }

    function canUpdateEventMediaOutputs() {
      return hasPermission('multimedia.project')
        && onlyEventKeys(['mediaOutputs', 'canvaOutputs'])
        && validMediaOutputsMap()
        && (
          !changedEventKeys().hasAny(['canvaOutputs'])
          || (validCanvaOutputsMap() && canvaOutputsOnlyRemove())
        );
    }

    // KADOSH_CANVA_OUTPUT_DESK_RULES_V1
    function validCanvaOutputState(state) {
      return state is map
        && state.keys().hasOnly([
          'active', 'presentationId', 'title', 'sourceUrl', 'embedUrl',
          'page', 'pageCount', 'updatedAt', 'updatedBy'
        ])
        && state.active == true
        && state.presentationId is string
        && state.title is string
        && state.sourceUrl is string
        && state.embedUrl is string
        && (!('page' in state) || (state.page is int && state.page >= 1 && state.page <= 500))
        && (!('pageCount' in state) || (state.pageCount is int && state.pageCount >= 0 && state.pageCount <= 500))
        && (!('page' in state) || !('pageCount' in state) || state.pageCount == 0 || state.page <= state.pageCount)
        && state.updatedAt is int
        && state.updatedBy is string;
    }

    function validCanvaOutputsMap() {
      let outputs = request.resource.data.canvaOutputs;
      return outputs is map
        && outputs.keys().hasOnly(['projector', 'singers', 'musicians'])
        && (!('projector' in outputs) || validCanvaOutputState(outputs.projector))
        && (!('singers' in outputs) || validCanvaOutputState(outputs.singers))
        && (!('musicians' in outputs) || validCanvaOutputState(outputs.musicians));
    }

    function validCanvaPageMemory() {
      let memory = request.resource.data.canvaPageMemory;
      return memory is map
        && memory.keys().hasOnly(['projector', 'singers', 'musicians'])
        && (!('projector' in memory) || (memory.projector is map && memory.projector.size() <= 500))
        && (!('singers' in memory) || (memory.singers is map && memory.singers.size() <= 500))
        && (!('musicians' in memory) || (memory.musicians is map && memory.musicians.size() <= 500));
    }

    function canUpdateEventCanvaOutputs() {
      return hasPermission('canva.project')
        && onlyEventKeys(['canvaOutputs', 'mediaOutputs', 'canvaPageMemory'])
        && validCanvaOutputsMap()
        && (
          !changedEventKeys().hasAny(['mediaOutputs'])
          || (validMediaOutputsMap() && mediaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['canvaPageMemory'])
          || validCanvaPageMemory()
        );
    }

    function canUpdateEventBibleOutline() {
      return (hasPermission('bible.project') || hasPermission('events.edit'))
        && onlyEventKeys(['bibleOutline'])
        && request.resource.data.bibleOutline is map
        && request.resource.data.bibleOutline.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.bibleOutline.items is list
        && request.resource.data.bibleOutline.items.size() <= 50;
    }

    function canUpdateEventSetlist() {
      return onlyEventKeys(['setlist', 'canciones'])
        && hasPermission('setlists.manage');
    }

    function validAnnouncementState() {
      return request.resource.data.announcementState is map
        && request.resource.data.announcementState.keys().hasOnly([
          'announcementId', 'currentSlideIndex', 'currentSlide', 'totalSlides',
          'presentationActive', 'transition', 'autoAdvance', 'updatedAt'
        ])
        && request.resource.data.announcementState.announcementId is string
        && request.resource.data.announcementState.currentSlideIndex is int
        && request.resource.data.announcementState.currentSlideIndex >= 0
        && request.resource.data.announcementState.totalSlides is int
        && request.resource.data.announcementState.totalSlides >= 0
        && request.resource.data.announcementState.totalSlides <= 100
        && request.resource.data.announcementState.presentationActive is bool
        && request.resource.data.announcementState.transition is map
        && request.resource.data.announcementState.transition.type in ['fade', 'slide', 'zoom']
        && request.resource.data.announcementState.transition.durationMs is int
        && request.resource.data.announcementState.transition.durationMs >= 0
        && request.resource.data.announcementState.transition.durationMs <= 5000
        && request.resource.data.announcementState.autoAdvance is map
        && request.resource.data.announcementState.autoAdvance.enabled is bool
        && request.resource.data.announcementState.autoAdvance.durationMs is int
        && request.resource.data.announcementState.autoAdvance.durationMs >= 1000
        && request.resource.data.announcementState.autoAdvance.durationMs <= 3600000
        && (
          !request.resource.data.announcementState.presentationActive
          || (
            request.resource.data.announcementState.announcementId != ''
            && exists(/databases/$(database)/documents/anuncios/$(request.resource.data.announcementState.announcementId))
            && request.resource.data.announcementState.totalSlides > 0
            && request.resource.data.announcementState.currentSlideIndex < request.resource.data.announcementState.totalSlides
            && request.resource.data.announcementState.currentSlide is map
            && request.resource.data.announcementState.currentSlide.keys().hasOnly(['id'])
            && request.resource.data.announcementState.currentSlide.id is string
            && request.resource.data.announcementState.currentSlide.id != ''
          )
        );
    }

    function validInactiveAnnouncementState() {
      return validAnnouncementState()
        && request.resource.data.announcementState.announcementId == ''
        && request.resource.data.announcementState.currentSlideIndex == 0
        && request.resource.data.announcementState.currentSlide == null
        && request.resource.data.announcementState.totalSlides == 0
        && request.resource.data.announcementState.presentationActive == false
        && request.resource.data.announcementState.autoAdvance.enabled == false;
    }

    function canUpdateEventAnnouncement() {
      return hasPermission('announcements.project')
        && onlyEventKeys([
          'announcementState', 'projectorState', 'liveState', 'proyectorMedia',
          'proyectorSlide', 'proyectorFondo', 'proyectorFondoMedia', 'currentSongId',
          'proyectorSongId', 'proyectorSlideIndex', 'proyectorNextSlide',
          'proyectorNextSong', 'proyectorLogo', 'proyectorApagado'
        ])
        && request.resource.data.projectorState is map
        && request.resource.data.projectorState.type in ['announcement', 'resume']
        && request.resource.data.projectorState.keys().hasOnly([
          'type', 'contentType', 'title', 'content', 'media', 'background', 'backgroundMedia', 'updatedAt'
        ])
        && request.resource.data.projectorState.media == null
        && validAnnouncementState();
    }

    function canUpdateEventAsParticipant() {
      return signedIn() && onlyEventKeys(sharedEventParticipationFields());
    }

    // KADOSH_SONG_PROJECTION_RULES_V1
    function canUpdateEventLyricsProjection() {
      return hasPermission('multimedia.project')
        && request.resource.data.projectorState is map
        && request.resource.data.projectorState.type == 'lyrics'
        && request.resource.data.projectorState.contentType == 'lyrics'
        && request.resource.data.projectorState.media == null
        && request.resource.data.proyectorMedia == null
        && onlyEventKeys(projectorEventFields())
        && (
          !changedEventKeys().hasAny(['canvaOutputs'])
          || (request.resource.data.canvaOutputs is map && canvaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['mediaOutputs'])
          || (request.resource.data.mediaOutputs is map && mediaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['announcementState'])
          || validInactiveAnnouncementState()
        );
    }

    // KADOSH_BIBLE_PROJECTION_RULES_V1
    function canUpdateEventBibleProjection() {
      return hasPermission('bible.project')
        && request.resource.data.projectorState is map
        && request.resource.data.projectorState.type == 'preaching'
        && request.resource.data.projectorState.contentType == 'bible'
        && request.resource.data.projectorState.media == null
        && request.resource.data.proyectorMedia == null
        && request.resource.data.proyectorFondo == null
        && request.resource.data.proyectorFondoMedia == null
        && onlyEventKeys(bibleProjectionFields())
        && biblePreviousProjectionIsTrusted()
        && (
          !changedEventKeys().hasAny(['canvaOutputs'])
          || (request.resource.data.canvaOutputs is map && canvaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['mediaOutputs'])
          || (request.resource.data.mediaOutputs is map && mediaOutputsOnlyRemove())
        )
        && (
          !changedEventKeys().hasAny(['announcementState'])
          || validInactiveAnnouncementState()
        )
        && (
          !changedEventKeys().hasAny(['projectionTargets'])
          || validProjectionTargetsMap()
        );
    }

    function canUpdateEventProjection(eventoId) {
      let state = request.resource.data.projectorState;
      return state is map && state.type == 'lyrics' && state.contentType == 'lyrics'
        ? canUpdateEventLyricsProjection()
        : (state is map && state.type == 'preaching' && state.contentType == 'bible'
          ? canUpdateEventBibleProjection()
          : (state is map && state.type == 'announcement'
          ? canUpdateEventAnnouncement()
            : (state is map && 'sourceActor' in state && state.sourceActor == 'pastor'
              ? canUpdateEventAsPastorProjection(eventoId)
              : canUpdateEventAsMedia())));
    }

    function canUpdateEvent(eventoId) {
      let projectionChange = changedEventKeys().hasAny(['projectorState']);
      let controlChange = changedEventKeys().hasAny(projectorControlFields());
      return controlChange
        ? canUpdateProjectorControls()
        : (projectionChange
        ? (isExactBlackoutRestore()
          ? hasPermission('multimedia.controlOutputs')
          : (request.resource.data.projectorState is map
          && request.resource.data.projectorState.contentType == 'quickMessage'
          && !isExactBibleRestore()
          ? false
          : canUpdateEventProjection(eventoId)))
        : (canUpdateEventAsAdmin()
          || canUpdateEventSetlist()
          || canUpdateEventBibleOutline()
          || canUpdateEventCanvaOutputs()
          || canUpdateEventMediaOutputs()
          || canUpdateEventAsParticipant()
          || canUpdateEventAsMedia()));
    }

    function canUpdateEventAsPastorProjection(eventoId) {
      return onlyEventKeys(pastorProjectionFields())
        && (
          isPastorPreachingProjectorState(eventoId)
          || isPastorPreachingMediaProjectorState(eventoId)
          || isCurrentPastorPreachingProjectorState(eventoId)
        );
    }

    function isOwnerBootstrap() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == 'luistorresdrums2024@gmail.com'
        && request.resource.data.rol == 'dueño';
    }

    function isSafeSelfProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveUserFields());
    }

    function preservesOwnOwnerRole(userId) {
      return !(request.auth.uid == userId && resource.data.rol in ['dueño', 'dueno'])
        || request.resource.data.rol in ['dueño', 'dueno'];
    }

    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create: if (isOwnerOnly() && request.resource.data.keys().hasOnly(ownerUserCreateFields()))
        || ((isAdminLike() || hasPermission('team.edit')) && isSafeUserCreate())
        || (signedIn() && request.auth.uid == userId && request.resource.data.rol == 'musico' && isSafeUserCreate())
        || (signedIn() && request.auth.uid == userId && isOwnerBootstrap());
      allow update: if (
        isSafeSelfProfileUpdate(userId)
        || (isOwnerOnly()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissionOverrides', 'permissionAudit']))
          || ((isAdminLike() || hasPermission('team.edit'))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveUserFields()))
      ) && preservesOwnOwnerRole(userId);
      allow delete: if isOwnerOnly() && request.auth.uid != userId;

      match /notas/{noteId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /permissionAudit/{auditId} {
        allow read: if isOwnerOnly() || request.auth.uid == userId;
        allow read, write: if false;
      }
    }

    match /eventos/{eventoId} {
      // Public ministry/event state used by setlists, projector, stage display,
      // attendance, countdown, media, lyrics, announcements, and controller-free global.
      // Private preacher data must never live here; it belongs in /private/preacher.
      allow read: if signedIn();
      allow create: if hasPermission('events.create');
      allow update: if canUpdateEvent(eventoId);
      allow delete: if hasPermission('events.delete');

      match /preacherRequests/{requestId} {
        allow read: if isOwnerOrMedia() || isAdminReadOnly() || isAssignedPastorForEventPreaching(eventoId);
        allow create: if isValidPastorRequestCreate(eventoId);
        allow update: if isPastorCancellingOwnRequest(eventoId) || isOwnerOrMediaHandlingRequest();
        allow delete: if false;
      }

      match /preachingStatus/{predicaId} {
        allow read: if isOwnerOrMedia() || isAdminReadOnly() || isAssignedPastorForEventPreaching(eventoId);
        allow create, update: if isAssignedPastorForEventPreaching(eventoId)
          && predicaId == eventPreachingId(eventoId)
          && request.resource.data.pastorUid == request.auth.uid
          && request.resource.data.predicaId == predicaId;
        allow delete: if false;
      }

      match /private/preacher {
        allow read, write: if canUsePreacherPrivate();
      }

      match /private/{document=**} {
        allow read, write: if canUsePreacherPrivate();
      }
    }

    match /canciones/{songId} {
      allow read: if signedIn();
      allow create: if hasPermission('songs.create');
      allow update: if isOwnerOnly();
      allow delete: if hasPermission('songs.delete') && resource.data.archived == true;

      match /permissionAudit/{auditId} {
        allow read: if isOwnerOnly();
        allow write: if false;
      }
    }

    function validCanvaPresentationDocument() {
      return request.resource.data.keys().hasOnly([
          'title', 'inputUrl', 'sourceUrl', 'embedUrl', 'pageCount', 'defaultTargets', 'setlistId',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.setlistId is string
        && request.resource.data.setlistId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title != ''
        && request.resource.data.inputUrl is string
        && request.resource.data.sourceUrl is string
        && request.resource.data.embedUrl is string
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount >= 1
        && request.resource.data.pageCount <= 500
        && request.resource.data.defaultTargets is map
        && request.resource.data.defaultTargets.keys().hasOnly(['projector', 'singers', 'musicians'])
        && request.resource.data.defaultTargets.projector is bool
        && request.resource.data.defaultTargets.singers is bool
        && request.resource.data.defaultTargets.musicians is bool
        && request.resource.data.createdAt is int
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy is string;
    }

    match /canvaPresentations/{presentationId} {
      allow read: if signedIn() && (
        hasPermission('canva.view')
        || hasPermission('canva.create')
        || hasPermission('canva.edit')
        || hasPermission('canva.delete')
        || hasPermission('canva.project')
      );
      allow create: if hasPermission('canva.create') && validCanvaPresentationDocument();
      allow update: if hasPermission('canva.edit') && validCanvaPresentationDocument();
      allow delete: if hasPermission('canva.delete');
    }

    match /mediaLibrary/{mediaId} {
      allow read: if hasPermission('multimedia.libraryView') || (isPastorRole() && isSharedActiveMediaResource());
      allow create: if hasPermission('multimedia.upload');
      allow update: if hasPermission('multimedia.edit');
      allow delete: if hasPermission('multimedia.delete');
    }

    match /anuncios/{announcementId} {
      allow read: if hasPermission('announcements.view') || hasPermission('announcements.project');
      allow create: if hasPermission('announcements.create');
      allow update: if hasPermission('announcements.edit');
      allow delete: if hasPermission('announcements.delete');
    }

    match /predicas/{predicaId} {
      allow read: if canReadPreachingShared();
      allow create: if canCreatePreachingShared();
      allow update: if canUpdatePreachingShared();
      allow delete: if false;

      match /private/preacher {
        allow read, create, update: if canUsePreachingPrivate(predicaId);
        allow delete: if canUsePreachingPrivate(predicaId) || isOwnerOrMedia();
      }

      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    match /sistema/teamAccessPin {
      allow read, create, update: if isOwnerOnly();
      allow delete: if false;
    }

    match /sistema/permissionRoles {
      allow read: if signedIn();
      allow write: if false;

      match /audit/{auditId} {
        allow read: if isOwnerOnly();
        allow write: if false;
      }
    }

    match /sistema/{document} {
      allow read: if document != 'teamAccessPin' && signedIn();
      allow write: if document != 'teamAccessPin' && document != 'permissionRoles' && isMediaOrAdmin();
    }

    match /sistema/{document}/{subdocument=**} {
      allow read: if signedIn();
      allow write: if document != 'permissionRoles' && isMediaOrAdmin();
    }

    match /notificaciones/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if isAdminLike();
    }

    match /plantillasEquipo/{templateId} {
      allow read: if signedIn();
      allow write: if isAdminLike();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
